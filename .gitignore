# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/.output/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-dev-*.log
/.npm-cache/
/.pip-cache/
/.codex-py/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/.wrangler/
/outputs/
/work/

/.hallmark/
/.openai/

# desktop binaries
/desktop/*.app
/desktop/api_sniff
/desktop/debug_app
/desktop/dump_sync
/desktop/sync_daemon
/desktop/test_run
