# ==========================================
# Quiet Plan - Environment Configuration
# ==========================================
# Note: The application is 100% operational offline out of the box using Dexie / IndexedDB.
# The external service integrations below are entirely optional.

# --- Supabase Cloud Sync (Optional) ---
# SUPABASE_URL=https://<your-project-ref>.supabase.co
# SUPABASE_SECRET_KEY=<your-service-role-key>

# --- Web Push Notifications & VAPID (Optional) ---
# VAPID_PUBLIC_KEY=<your-vapid-public-key>
# VAPID_PRIVATE_KEY=<your-vapid-private-key>
# VAPID_SUBJECT=mailto:admin@example.com
# REMINDER_CRON_SECRET=<your-cron-secret>

# --- AI Assistant / OpenAI-compatible endpoint (Optional) ---
# AGNES_API_KEY=<your-api-key>
# AGNES_BASE_URL=https://api.openai.com/v1
# AGNES_MODEL=gpt-4o-mini
